APP_NAME=Electronics AI Service
APP_ENV=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

BACKEND_API_BASE_URL=http://localhost:8000
BACKEND_API_TIMEOUT=10

# Optional: startup and placeholder endpoints work without these values.
# Base URL is the API root (for example https://api.openai.com/v1).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Positive HTTPX timeout in seconds per network operation.
LLM_TIMEOUT=30

# Set a random service key of at least 32 characters; never commit its value.
RECOMMENDATION_SERVICE_KEY=
# Optional JSON overrides for centralized scoring weights.
RECOMMENDATION_WEIGHTS={}
